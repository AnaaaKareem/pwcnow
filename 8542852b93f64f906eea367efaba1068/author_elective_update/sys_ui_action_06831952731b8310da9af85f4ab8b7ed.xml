        <script><![CDATA[// Check user role and redirect to the corresponding custom list view
if (gs.hasRole('x_2182380_pwcnow.hr_agent')) {
    action.setRedirectURL('x_2182380_pwcnow_employee_document_list.do?sysparm_view=hr_doc_request');
} else if (gs.hasRole('x_2182380_pwcnow.employee')) {
    // For regular employees, filter to only show their own records
    var currentUser = gs.getUserID();
    action.setRedirectURL('x_2182380_pwcnow_employee_document_list.do?sysparm_view=employee_doc_sub&sysparm_query=u_employee=' + currentUser);
} else {
    // Default fallback
    action.setRedirectURL('x_2182380_pwcnow_employee_document_list.do');
}]]></script>
