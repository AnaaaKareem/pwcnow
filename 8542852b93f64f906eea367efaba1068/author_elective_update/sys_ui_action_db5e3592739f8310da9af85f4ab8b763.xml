        <script><![CDATA[// Check user role and redirect to the corresponding custom training list view
if (gs.hasRole('x_2182380_pwcnow.hr_agent')) {
    action.setRedirectURL('x_2182380_pwcnow_training_list.do?sysparm_view=Assign_Training');
} else if (gs.hasRole('x_2182380_pwcnow.employee')) {
    // For regular employees, filter to only show their own training records
    var currentUser = gs.getUserID();
    action.setRedirectURL('x_2182380_pwcnow_training_list.do?sysparm_view=Employee_Training_Dashboard&sysparm_query=u_employee=' + currentUser);
} else {
    // Default fallback
    action.setRedirectURL('x_2182380_pwcnow_training_list.do');
}]]></script>
