        <name>Cancel Request</name>
        <onclick/>
        <order>100</order>
        <script><![CDATA[if (!current.isNewRecord()) {
    // Verify the logged-in user is the owner of the document
    if (current.getValue('u_employee') == gs.getUserID()) {
        current.setValue('u_status', 'cancelled');
        current.update();
        gs.addInfoMessage('Document request has been cancelled.');
    } else {
        gs.addErrorMessage('You can only cancel your own document requests.');
    }
}

// Redirect back to the Employee Document list
action.setRedirectURL('x_2182380_pwcnow_employee_document_list.do');]]></script>
