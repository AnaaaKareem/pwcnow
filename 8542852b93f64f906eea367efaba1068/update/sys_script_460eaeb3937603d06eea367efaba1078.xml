        <script><![CDATA[(function executeRule(current, previous /*null when async*/) {
    var status = current.getValue('u_status');

    // 1. Mandatory Reviewer Comments check when returning for revision
    if (status == 'returned' && current.u_reviewer_comments.nil()) {
        gs.addErrorMessage('Reviewer Comments are mandatory when returning a document for revision.');
        current.setAbortAction(true);
        return;
    }

    // 2. Automatically stamp the reviewing agent ID on state change
    if (current.u_status.changesTo('accepted') || current.u_status.changesTo('returned')) {
        current.setValue('u_reviewed_by', gs.getUserID());
    }
})(current, previous);]]></script>
