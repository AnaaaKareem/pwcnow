        <script><![CDATA[(function checkOverdueTrainings() {
    var trainingGr = new GlideRecord('x_2182380_pwcnow_employee_training');
    // Finds active training that is past its due date
    trainingGr.addQuery('u_status', 'NOT IN', ['completed', 'overdue']);
    trainingGr.addQuery('u_due_date', '<', gs.beginningOfToday());
    trainingGr.query();

    while (trainingGr.next()) {
        trainingGr.setValue('u_status', 'overdue');
        trainingGr.update();
    }
})();]]></script>
