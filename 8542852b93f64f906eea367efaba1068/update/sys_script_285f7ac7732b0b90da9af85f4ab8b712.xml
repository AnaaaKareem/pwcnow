        <script><![CDATA[(function executeRule(current, previous) {

    var today = new GlideDate();
    var dueDate = new GlideDate();

    if (current.u_due_date)
        dueDate.setValue(current.getValue('u_due_date'));

    if (current.u_status == 'requested' &&
        current.u_due_date &&
        dueDate.before(today)) {

        current.u_status = 'overdue';
    }

})(current, previous);]]></script>
