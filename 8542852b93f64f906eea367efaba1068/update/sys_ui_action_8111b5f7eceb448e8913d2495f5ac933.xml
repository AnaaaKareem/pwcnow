        <script><![CDATA[function returnDocument() {
    var comments = g_form.getValue('u_reviewer_comments');
    if (!comments || comments.trim() === '') {
        g_form.hideFieldMsg('u_reviewer_comments');
        g_form.showFieldMsg('u_reviewer_comments', 'Please provide comments explaining why the document was returned.', 'error');
        g_form.setMandatory('u_reviewer_comments', true);
        return false;
    }
    // Triggers the server execution below
    gsftSubmit(null, g_form.getFormElement(), 'return_document');
}

if (typeof window == 'undefined') {
    runReturnServerCode();
}

function runReturnServerCode() {
    current.setValue('u_status', 'returned');
    current.setValue('u_reviewed_by', gs.getUserID());
    current.update();

    gs.addInfoMessage('Document has been returned for revision.');
    action.setRedirectURL('x_2182380_pwcnow_employee_document_list.do');
}]]></script>
