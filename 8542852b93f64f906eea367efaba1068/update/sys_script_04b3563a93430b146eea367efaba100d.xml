        <script><![CDATA[(function executeRule(current, previous /*null when async*/) {
    // If the record is already Accepted and someone attempts to change attachment or status
    if (previous.getValue('u_status') == 'accepted' && !gs.hasRole('admin')) {
        if (current.u_document_attachment.changes() || current.u_employee.changes()) {
            gs.addErrorMessage('Accepted compliance documents cannot be modified.');
            current.setAbortAction(true);
        }
    }
})(current, previous);]]></script>
